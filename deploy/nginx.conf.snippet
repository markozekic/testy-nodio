# Varianta pro nginx (pokud na VPS neběží Caddy).
# 1) Soubor s heslem:   sudo htpasswd -cbB /etc/nginx/.htpasswd-testy meda dvk
# 2) Vlož do /etc/nginx/sites-available/testy.nodio.cz, aktivuj a spusť: sudo nginx -t && sudo systemctl reload nginx
# 3) HTTPS: sudo certbot --nginx -d testy.nodio.cz
server {
	listen 80;
	server_name testy.nodio.cz;
	root /var/www/testy.nodio.cz/public;
	index index.html;
	auth_basic "Testy pro Medu";
	auth_basic_user_file /etc/nginx/.htpasswd-testy;
	add_header X-Robots-Tag "noindex, nofollow" always;
	location / { try_files $uri $uri/ =404; }
}
